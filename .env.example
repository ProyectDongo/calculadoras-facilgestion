# calculadoras.facilgestion.cl — variables de entorno.
#
# Copia a .env y rellena. NUNCA commitees .env (está en .gitignore).
# Genera secretos con: python -c "import secrets;print(secrets.token_urlsafe(50))"

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=calculadoras.facilgestion.cl,localhost,127.0.0.1
DJANGO_DEBUG=False

# ── Redis (rate limiting, cache) ─────────────────────────────────────────────
# En dev sin password (red interna docker). En prod requerido.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Obtén las keys en https://dash.cloudflare.com → Turnstile → Add site
# Modo: Managed (invisible salvo en caso de challenge)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email SMTP (reutiliza credenciales del ERP) ──────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FacilGestion Calculadoras <calculadoras@facilgestion.cl>

# ── Hash salt (para hashing efímero en rate limiter; nunca para PII) ─────────
# No almacenamos IPs ni emails, pero el ratelimiter hashea claves antes de
# escribir a Redis. Salt fijo del proyecto.
IP_HASH_SALT=

# ── Cloudflare (opcional, sólo si se mueven CSP reports a Cloudflare) ────────
# CSP_REPORT_URI=
